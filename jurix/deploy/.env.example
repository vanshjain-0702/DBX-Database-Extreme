# Copy to jurix/.env; pass --env-file jurix/.env to every Compose command.
# Generate unique keys before starting. Empty required values intentionally fail.
JURIX_HOST=jurix.example.internal
JURIX_PUBLIC_ORIGIN=https://jurix.example.internal
# Replace with the server's private/VPN interface address before remote access.
JURIX_BIND_IP=127.0.0.1
JURIX_ENV=production
JURIX_ENCRYPTION_KEY=
JURIX_AUDIT_KEY=
# False permits only the first bootstrap administrator to register a firm.
JURIX_REGISTRATION_OPEN=false
DBX_PASSWORD=
DBX_JWT_SECRET=
DBX_INTERNAL_API_TOKEN=
DBX_KEK=
DBX_REQUIRE_DISK_ENCRYPTION=1
DBX_NODE_MEMORY_BUDGET=2gb
JURIX_IMAGE_TAG=local
JURIX_DATA_VOLUME=jurix-data
DBX_DATA_VOLUME=jurix-dbx-data
# Secret file paths are resolved relative to jurix/deploy/compose.yml.
DBX_TLS_CERT_FILE=./secrets/dbx.crt
DBX_TLS_KEY_FILE=./secrets/dbx.key
DBX_TLS_CA_FILE=./secrets/dbx-ca.crt
# Absolute directory on the PRIVATE SERVER, owned by uid 10001, mode 0700.
JURIX_BACKUP_DIR=/srv/jurix-backups
# Optional, enabled only with approved credentials and per-matter consent.
OPENAI_API_KEY=
JURIX_OPENAI_MODEL=
JURIX_TRANSCRIPTION_MODEL=whisper-1
JURIX_AZURE_OCR_ENDPOINT=
JURIX_AZURE_OCR_KEY=
