# Copy to .env in the repo root (not deploy/) and replace every value.
# Never commit .env.
#
# Compose (deploy/docker-compose.yml) interpolates this file only if you pass
#   docker compose --env-file .env -f deploy/docker-compose.yml ...
# or `make docker-up`. A .env sitting next to the compose file is not enough.
#
# DBX_ADMIN_PASSWORD: min 12 characters. Dashboard login is username admin.
# DBX_JWT_SECRET and DBX_INTERNAL_API_TOKEN: min 32 characters.
# DBX_KEK: 64 hex characters (256-bit wrapping key). Required whenever
# isolation is standard or strict (Compose and the Docker image default to
# strict). Generate one of:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
DBX_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DBX_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DBX_DEFAULT_PASSWORD=replace-with-a-strong-engine-password
DBX_INTERNAL_API_TOKEN=replace-with-a-random-internal-api-token-at-least-32-characters
DBX_KEK=
DBX_ISOLATION_MODE=strict
DBX_NODE_MEMORY_BUDGET=8gb
DBX_DATA_DIR=./data
