# Standalone engine binary. The supported product image is deploy/Dockerfile
# (orchestrator + embedded dashboard + RESP :6380).
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/bin/dbx-server ./cmd/dbx-server

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/bin/dbx-server /app/bin/dbx-server
COPY --from=builder /app/configs /app/configs
VOLUME ["/app/data", "/app/certs"]
EXPOSE 6399
CMD ["/app/bin/dbx-server", "-config", "/app/configs/local.yaml"]
